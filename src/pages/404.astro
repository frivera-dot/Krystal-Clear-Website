---
import Layout from "../layouts/Layout.astro";
import { SITE } from "../config/site";
---

<Layout
  title="Page Not Found | KCS Krystal Clear Service"
  description="That page doesn't exist — but our crews probably clean somewhere near it. Find your city or service."
  noindex
>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="eyebrow text-brass-600">Error 404 — not on the route sheet</p>
    <h1 class="mt-3 font-display text-5xl font-bold uppercase text-pine-900">Page Not Found</h1>
    <p class="mt-4 text-lg text-stone-600">
      This page doesn't exist — but if your building is anywhere between San Francisco and Modesto, we probably
      clean near it.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="bg-pine-900 px-6 py-3 font-display font-bold uppercase tracking-wider text-white hover:bg-pine-800">Home</a>
      <a href="/services/" class="border border-pine-900/30 px-6 py-3 font-display font-bold uppercase tracking-wider text-pine-900 hover:border-pine-700">Services</a>
      <a href="/locations/" class="border border-pine-900/30 px-6 py-3 font-display font-bold uppercase tracking-wider text-pine-900 hover:border-pine-700">Find Your City</a>
    </div>
    <p class="mt-8 text-sm text-stone-500">
      Or call <a href={SITE.phoneHref} class="font-bold text-brass-700">{SITE.phone}</a> — a human answers.
    </p>
  </section>
</Layout>
