---
// Internal brand board — for client presentation only (noindex, excluded from sitemap).
// SELECTED DIRECTION: Concept F — comp letterforms (Orbitron Black), pine & brass
// colorways. This board now holds the F family only: the two original cuts plus
// dimensional (3D / shadow) explorations for signage, print, and web.
import "@fontsource/orbitron/900.css";
import "@fontsource/michroma";
import "@fontsource/chakra-petch/700.css";
import "@fontsource/audiowide";
import Layout from "../../layouts/Layout.astro";

const palette = [
  { name: "Pine 950", hex: "#0b211a", note: "Ink — dark surfaces, footer" },
  { name: "Pine 900", hex: "#123227", note: "Primary — uniform green" },
  { name: "Pine 700", hex: "#1f523a", note: "Links, secondary" },
  { name: "Pine 50", hex: "#f0f4f0", note: "Tinted surfaces" },
  { name: "Brass 500", hex: "#c09a3e", note: "Accent — the K, CTAs, rules" },
  { name: "Brass 300", hex: "#dcc077", note: "Accent on dark" },
  { name: "Stone 700", hex: "#44403b", note: "Body text (warm gray)" },
  { name: "White", hex: "#ffffff", note: "Primary surface" },
];
---

<Layout
  title="KCS Brand Board — Internal"
  description="Internal brand direction board for KCS Krystal Clear Service."
  noindex
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <p class="eyebrow text-brass-600">Internal — selected direction</p>
    <h1 class="mt-2 font-display text-4xl font-bold uppercase text-pine-900 sm:text-5xl">KCS Logo — Concept F</h1>
    <p class="mt-4 max-w-2xl text-lg text-stone-600">
      Client-approved direction: the cut wordmark in the <strong>pine &amp; brass</strong> colorways. Below: the two
      original cuts, plus dimensional explorations — extruded, floating, machined metal, and the LED-backlit
      treatment Fidel described for the office door sign.
    </p>

    <!-- Original F cuts (unchanged) -->
    <h2 class="mt-14 font-display text-2xl font-bold uppercase text-pine-900">F · Original Cuts</h2>
    <div class="mt-6 grid gap-8 lg:grid-cols-2">
      <div class="border border-stone-200">
        <div class="flex items-center justify-between border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">F1 · Flat on Pine</h3>
          <span class="eyebrow text-brass-600">Web · documents</span>
        </div>
        <div class="flex flex-col items-center gap-4 bg-pine-950 px-6 py-12">
          <p class="cut-wordmark text-white"><span class="text-brass-500">K</span>CS</p>
          <p class="mt-1 font-display text-sm font-semibold uppercase tracking-[0.42em] text-white">Krystal Clear Service</p>
          <p class="eyebrow text-brass-300">Janitorial · Floor Care</p>
        </div>
      </div>
      <div class="border border-stone-200">
        <div class="flex items-center justify-between border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">F2 · Flat on White</h3>
          <span class="eyebrow text-brass-600">Print · invoices</span>
        </div>
        <div class="flex flex-col items-center gap-4 bg-white px-6 py-12">
          <p class="cut-wordmark text-pine-900"><span class="text-brass-600">K</span>CS</p>
          <p class="mt-1 font-display text-sm font-semibold uppercase tracking-[0.42em] text-pine-900">Krystal Clear Service</p>
        </div>
      </div>
    </div>

    <!-- Dimensional explorations -->
    <h2 class="mt-14 font-display text-2xl font-bold uppercase text-pine-900">F · Dimensional Explorations</h2>
    <p class="mt-2 max-w-2xl text-stone-600">
      Same letterforms, four physical treatments. Each maps to a real production method, so what Fidel approves on
      screen is buildable in the shop.
    </p>

    <div class="mt-6 grid gap-8 lg:grid-cols-2">
      <!-- F3: Extruded block -->
      <div class="border border-stone-200">
        <div class="flex items-center justify-between border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">F3 · Extruded Block</h3>
          <span class="eyebrow text-brass-600">Vehicle wraps · banners</span>
        </div>
        <div class="flex flex-col items-center gap-4 bg-pine-950 px-6 py-14">
          <p class="cut-wordmark f-extrude text-white"><span class="k">K</span>CS</p>
          <p class="mt-3 font-display text-sm font-semibold uppercase tracking-[0.42em] text-white">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-sm text-stone-600">
          Solid diagonal extrusion in deep pine — sign-shop dimensional letters. Reads big and confident at
          distance; built for the truck doors and jobsite banners.
        </p>
      </div>

      <!-- F4: Floating soft shadow -->
      <div class="border border-stone-200">
        <div class="flex items-center justify-between border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">F4 · Floating</h3>
          <span class="eyebrow text-brass-600">Website hero · proposals</span>
        </div>
        <div class="flex flex-col items-center gap-4 bg-pine-50 px-6 py-14">
          <p class="cut-wordmark f-float text-pine-900"><span class="text-brass-600">K</span>CS</p>
          <p class="mt-3 font-display text-sm font-semibold uppercase tracking-[0.42em] text-pine-900">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-sm text-stone-600">
          Soft grounded shadow lifting the letters off the surface — the subtle-depth look from the comps. The
          quiet one: proposals, letterhead, web headers.
        </p>
      </div>

      <!-- F5: Machined metal -->
      <div class="border border-stone-200">
        <div class="flex items-center justify-between border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">F5 · Machined Metal</h3>
          <span class="eyebrow text-brass-600">Stainless door plaque</span>
        </div>
        <div class="flex flex-col items-center gap-4 bg-[linear-gradient(160deg,#1a3b2d_0%,#0b211a_70%)] px-6 py-14">
          <p class="cut-wordmark f-metal"><span class="k">K</span>CS</p>
          <p class="mt-3 font-display text-sm font-semibold uppercase tracking-[0.42em] text-white/90">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-sm text-stone-600">
          Brushed-metal gradients with machined bevel edges — brass K, steel CS. This is the cut-stainless plaque
          treatment for the Pleasant Hill office door.
        </p>
      </div>

      <!-- F6: LED backlit -->
      <div class="border border-stone-200">
        <div class="flex items-center justify-between border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">F6 · LED Backlit</h3>
          <span class="eyebrow text-brass-600">The door sign Fidel described</span>
        </div>
        <div class="flex flex-col items-center gap-4 bg-[#06120d] px-6 py-14">
          <p class="cut-wordmark f-backlit text-white"><span class="k">K</span>CS</p>
          <p class="mt-3 font-display text-sm font-semibold uppercase tracking-[0.42em] text-pine-200">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-sm text-stone-600">
          Halo-lit metal letters — the "nice KCS logo with an LED light in the back, but metal" from the kickoff
          call. Warm brass glow behind the K, cool white behind CS.
        </p>
      </div>
    </div>

    <!-- Extended dimensional set -->
    <h2 class="mt-14 font-display text-2xl font-bold uppercase text-pine-900">F · More Depth &amp; Shadow</h2>
    <div class="mt-6 grid gap-8 lg:grid-cols-2">
      <!-- F7: Cast shadow -->
      <div class="border border-stone-200">
        <div class="flex items-center justify-between border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">F7 · Cast Shadow</h3>
          <span class="eyebrow text-brass-600">Storefront in afternoon sun</span>
        </div>
        <div class="flex flex-col items-center gap-4 bg-pine-50 px-6 py-14">
          <p class="cut-wordmark f-cast text-pine-900"><span class="text-brass-600">K</span>CS</p>
          <p class="mt-3 font-display text-sm font-semibold uppercase tracking-[0.42em] text-pine-900">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-sm text-stone-600">
          A long 45° cast shadow fading out — dimensional letters on a lit wall. Strong for wide formats: banners,
          website bands, proposal covers.
        </p>
      </div>

      <!-- F8: Debossed -->
      <div class="border border-stone-200">
        <div class="flex items-center justify-between border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">F8 · Pressed In</h3>
          <span class="eyebrow text-brass-600">Stamped / engraved</span>
        </div>
        <div class="flex flex-col items-center gap-4 bg-pine-900 px-6 py-14">
          <p class="cut-wordmark f-deboss"><span class="k">K</span>CS</p>
          <p class="mt-3 font-display text-sm font-semibold uppercase tracking-[0.42em] text-pine-200">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-sm text-stone-600">
          Letters pressed into the surface — the engraved/stamped look for embossed folders, leather-grain binder
          covers, and etched metal.
        </p>
      </div>

      <!-- F9: Offset outline -->
      <div class="border border-stone-200">
        <div class="flex items-center justify-between border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">F9 · Offset Outline</h3>
          <span class="eyebrow text-brass-600">Apparel · patches</span>
        </div>
        <div class="relative flex flex-col items-center gap-4 bg-pine-950 px-6 py-14">
          <span class="relative">
            <span class="cut-wordmark f-outline-ghost absolute left-1.5 top-1.5" aria-hidden="true">KCS</span>
            <p class="cut-wordmark relative text-white"><span class="text-brass-500">K</span>CS</p>
          </span>
          <p class="mt-3 font-display text-sm font-semibold uppercase tracking-[0.42em] text-white">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-sm text-stone-600">
          Solid letters over an offset brass outline — a two-layer print that embroiders beautifully on polos and
          crew jackets (two thread colors, no gradients).
        </p>
      </div>

      <!-- F10: Hard drop -->
      <div class="border border-stone-200">
        <div class="flex items-center justify-between border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">F10 · Hard Drop</h3>
          <span class="eyebrow text-brass-600">Posters · social</span>
        </div>
        <div class="flex flex-col items-center gap-4 bg-brass-500 px-6 py-14">
          <p class="cut-wordmark f-harddrop text-white">KCS</p>
          <p class="mt-3 font-display text-sm font-semibold uppercase tracking-[0.42em] text-pine-950">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-sm text-stone-600">
          Flat solid pine shadow, no blur — bold poster energy on the brass field. The loudest version: promos,
          social graphics, yard signs.
        </p>
      </div>
    </div>

    <!-- Type studies -->
    <h2 class="mt-14 font-display text-2xl font-bold uppercase text-pine-900">F · Type Studies</h2>
    <p class="mt-2 max-w-2xl text-stone-600">
      Same colorway, three alternative faces in the squared-industrial genre — in case Fidel wants to feel the
      range before locking the letterforms. All are professionally drawn, licensed, and web-ready.
    </p>
    <div class="mt-6 grid gap-8 lg:grid-cols-3">
      <div class="border border-stone-200">
        <div class="border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">T1 · Michroma</h3>
        </div>
        <div class="flex flex-col items-center gap-3 bg-pine-950 px-6 py-12">
          <p class="t-michroma text-white"><span class="text-brass-500">K</span>CS</p>
          <p class="mt-2 font-display text-xs font-semibold uppercase tracking-[0.42em] text-white">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-xs text-stone-600">
          The classic wide Eurostile look — closest to the original comps' DNA. Most "established corporation."
        </p>
      </div>
      <div class="border border-stone-200">
        <div class="border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">T2 · Chakra Petch</h3>
        </div>
        <div class="flex flex-col items-center gap-3 bg-pine-950 px-6 py-12">
          <p class="t-chakra text-white"><span class="text-brass-500">K</span>CS</p>
          <p class="mt-2 font-display text-xs font-semibold uppercase tracking-[0.42em] text-white">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-xs text-stone-600">
          Chamfered, angular corners — echoes the cut-corner language of the comps. Most "engineered."
        </p>
      </div>
      <div class="border border-stone-200">
        <div class="border-b border-stone-200 px-5 py-3">
          <h3 class="font-bold text-pine-900">T3 · Audiowide</h3>
        </div>
        <div class="flex flex-col items-center gap-3 bg-pine-950 px-6 py-12">
          <p class="t-audiowide text-white"><span class="text-brass-500">K</span>CS</p>
          <p class="mt-2 font-display text-xs font-semibold uppercase tracking-[0.42em] text-white">Krystal Clear Service</p>
        </div>
        <p class="border-t border-stone-200 px-5 py-4 text-xs text-stone-600">
          Rounded-tech — softer and friendlier while staying industrial. Most approachable of the three.
        </p>
      </div>
    </div>
    <p class="mt-4 max-w-2xl text-sm text-stone-500">
      Current pick (Orbitron) stays the default — any dimensional treatment above can be applied to any of these
      faces once Fidel lands on one.
    </p>

    <!-- Palette -->
    <h2 class="mt-16 font-display text-2xl font-bold uppercase text-pine-900">Palette</h2>
    <p class="mt-2 max-w-2xl text-stone-600">
      The approved green colorway: work-shirt pine, lobby brass, warm stone neutrals.
    </p>
    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        palette.map((c) => (
          <div class="border border-stone-200">
            <div class="h-20" style={`background:${c.hex}`} />
            <div class="px-3 py-2">
              <p class="text-sm font-bold text-pine-900">{c.name}</p>
              <p class="font-mono text-xs text-stone-500">{c.hex}</p>
              <p class="mt-1 text-xs text-stone-500">{c.note}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Type -->
    <h2 class="mt-16 font-display text-2xl font-bold uppercase text-pine-900">Typography</h2>
    <div class="mt-6 space-y-6">
      <div class="border border-stone-200 p-6">
        <p class="eyebrow text-brass-600">Logo — Orbitron Black</p>
        <p class="cut-wordmark mt-3 text-pine-900" style="font-size:2.6rem"><span class="text-brass-600">K</span>CS</p>
        <p class="mt-3 text-sm text-stone-500">
          The squared industrial face from the approved comps — used for the logo only.
        </p>
      </div>
      <div class="border border-stone-200 p-6">
        <p class="eyebrow text-brass-600">Display — Barlow Condensed Bold · Body — Barlow · Labels — IBM Plex Mono</p>
        <p class="mt-2 font-display text-3xl font-bold uppercase text-pine-900">The cleanest floors in Northern California</p>
        <p class="mt-2 max-w-2xl text-stone-700">
          Every facility is different, so we start with a free walkthrough and send a flat monthly or per-job quote.
        </p>
        <p class="eyebrow mt-3 text-pine-700">Work order № 001 · Licensed · Bonded · Insured</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cut-wordmark {
    font-family: "Orbitron", sans-serif;
    font-weight: 900;
    font-size: 4rem;
    line-height: 1;
    letter-spacing: 0.04em;
  }

  /* F3 — solid diagonal extrusion, sign-shop dimensional letters */
  .f-extrude {
    text-shadow:
      1px 1px 0 #071912, 2px 2px 0 #071912, 3px 3px 0 #071912, 4px 4px 0 #071912,
      5px 5px 0 #071912, 6px 6px 0 #071912, 7px 7px 0 #071912, 8px 8px 0 #071912,
      9px 9px 0 #071912, 10px 10px 0 #071912, 12px 14px 24px rgba(0, 0, 0, 0.45);
  }
  .f-extrude .k {
    color: var(--color-brass-500);
    text-shadow:
      1px 1px 0 #6b5222, 2px 2px 0 #6b5222, 3px 3px 0 #6b5222, 4px 4px 0 #6b5222,
      5px 5px 0 #6b5222, 6px 6px 0 #6b5222, 7px 7px 0 #6b5222, 8px 8px 0 #6b5222,
      9px 9px 0 #6b5222, 10px 10px 0 #6b5222, 12px 14px 24px rgba(0, 0, 0, 0.45);
  }

  /* F4 — floating with a soft grounded shadow */
  .f-float {
    text-shadow: 0 12px 28px rgba(11, 33, 26, 0.35), 0 3px 8px rgba(11, 33, 26, 0.22);
  }

  /* F5 — machined metal: brushed gradients + bevel edge light */
  .f-metal {
    background: linear-gradient(175deg, #ffffff 0%, #d7ddd9 35%, #9fA8a3 50%, #e8ecea 65%, #b9c1bd 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 2px 1px rgba(255, 255, 255, 0.25)) drop-shadow(0 6px 14px rgba(0, 0, 0, 0.55));
  }
  .f-metal .k {
    background: linear-gradient(175deg, #f0dfa8 0%, #c09a3e 40%, #8a6d2b 55%, #e3c878 70%, #a5812f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* F7 — long 45° cast shadow, fading like sun on a wall */
  .f-cast {
    text-shadow:
      2px 2px 0 rgba(11, 33, 26, 0.28), 4px 4px 0 rgba(11, 33, 26, 0.24),
      6px 6px 0 rgba(11, 33, 26, 0.2), 8px 8px 0 rgba(11, 33, 26, 0.16),
      10px 10px 0 rgba(11, 33, 26, 0.12), 12px 12px 0 rgba(11, 33, 26, 0.09),
      14px 14px 0 rgba(11, 33, 26, 0.06), 16px 16px 0 rgba(11, 33, 26, 0.04),
      18px 18px 0 rgba(11, 33, 26, 0.02);
  }

  /* F8 — pressed into the surface: dark above, light lip below */
  .f-deboss {
    color: #0e2a20;
    text-shadow: 0 -1px 1px rgba(0, 0, 0, 0.75), 0 1px 1px rgba(184, 214, 197, 0.28);
  }
  .f-deboss .k {
    color: #8a6d2b;
    text-shadow: 0 -1px 1px rgba(0, 0, 0, 0.7), 0 1px 1px rgba(240, 223, 168, 0.3);
  }

  /* F9 — offset outline layer behind solid letters */
  .f-outline-ghost {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-brass-500);
    opacity: 0.55;
  }

  /* F10 — flat solid shadow, zero blur, poster energy */
  .f-harddrop {
    text-shadow: 7px 7px 0 var(--color-pine-950);
  }

  /* Type studies — same size discipline as the Orbitron mark */
  .t-michroma {
    font-family: "Michroma", sans-serif;
    font-size: 3rem;
    line-height: 1;
    letter-spacing: 0.02em;
    -webkit-text-stroke: 1.5px currentColor;
  }
  .t-michroma .text-brass-500 {
    -webkit-text-stroke: 1.5px var(--color-brass-500);
  }
  .t-chakra {
    font-family: "Chakra Petch", sans-serif;
    font-weight: 700;
    font-size: 3.6rem;
    line-height: 1;
    letter-spacing: 0.03em;
  }
  .t-audiowide {
    font-family: "Audiowide", sans-serif;
    font-size: 3.1rem;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  /* F6 — LED backlit halo: warm glow behind the K, cool behind CS */
  .f-backlit {
    text-shadow:
      0 0 18px rgba(255, 255, 255, 0.55), 0 0 46px rgba(220, 235, 228, 0.35),
      0 0 90px rgba(200, 225, 214, 0.22), 0 2px 3px rgba(0, 0, 0, 0.8);
  }
  .f-backlit .k {
    color: var(--color-brass-400);
    text-shadow:
      0 0 18px rgba(192, 154, 62, 0.8), 0 0 46px rgba(192, 154, 62, 0.5),
      0 0 90px rgba(192, 154, 62, 0.3), 0 2px 3px rgba(0, 0, 0, 0.8);
  }
</style>
