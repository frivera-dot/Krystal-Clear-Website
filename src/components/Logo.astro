---
// Site logo — Concept F (client-approved): Orbitron cut wordmark, brass K.
interface Props {
  light?: boolean;
  /** kept for call-site compatibility; the F mark has no reflection */
  reflect?: boolean;
}
const { light = false } = Astro.props;
---

<span class="flex items-center gap-3">
  <span class={`font-logo text-[1.45rem] ${light ? "text-white" : "text-pine-900"}`}
    ><span class={light ? "text-brass-400" : "text-brass-600"}>K</span>CS</span
  >
  <span class={`border-l pl-3 leading-tight ${light ? "border-pine-100/25" : "border-stone-200"}`}>
    <span class={`block text-[0.95rem] font-semibold tracking-wide ${light ? "text-white" : "text-pine-900"}`}
      >Krystal Clear Service</span
    >
    <span class={`eyebrow block ${light ? "text-brass-300" : "text-brass-600"}`}>Janitorial · Floor Care</span>
  </span>
</span>
